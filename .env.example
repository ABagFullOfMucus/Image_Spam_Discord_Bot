# Discord bot token (required)
DISCORD_TOKEN=your-bot-token

# Discord channel ID to post images to (required)
DISCORD_CHANNEL_ID=your-channel-id

# Zerochan search tag (default: Satono+Diamond)
SEARCH_TAG=Satono+Diamond

# Number of pages to scrape per run (default: 30)
PAGES_PER_RUN=30

# Delay between page requests in ms (default: 3000)
REQUEST_DELAY_MS=3000

# Delay between Discord messages in ms (default: 2000)
DISCORD_DELAY_MS=2000

# Page load timeout in ms (default: 60000)
PAGE_TIMEOUT_MS=60000

# Max retries for Discord API calls (default: 3)
MAX_RETRIES=3

# Log level: debug | info | warn | error (default: info)
LOG_LEVEL=info